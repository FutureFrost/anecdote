{
    "type": "origins:multiple",
    "actor": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:set_resource",
                    "resource": "anecdote:books/actors/target/force_drown/entity_condition_resource",
                    "value": 0
                },
                {
                    "type": "origins:area_of_effect",
                    "radius": 16,
                    "bientity_condition": {
                        "type": "origins:target_condition",
                        "condition": {
                            "type": "origins:and",
                            "conditions": [
                                {
                                    "type": "origins:resource",
                                    "resource": "anecdote:books/resources/drowned_resource",
                                    "comparison": "!=",
                                    "compare_to": 0
                                }
                            ]
                        }
                    },
                    "bientity_action": {
                        "type": "origins:actor_action",
                        "action": {
                            "type": "origins:set_resource",
                            "resource": "anecdote:books/actors/target/force_drown/entity_condition_resource",
                            "value": 1
                        }
                    }
                },
                {
                    "type": "origins:if_else_list",
                    "actions": [
                        {
                            "condition": {
                                "type": "origins:resource",
                                "resource": "anecdote:books/actors/target/force_drown/entity_condition_resource",
                                "comparison": "==",
                                "compare_to": 1
                            },
                            "action": {
                                "type": "origins:if_else",
                                "condition": {
                                    "type": "origins:resource",
                                    "resource": "anecdote:books/actors/target/force_drown/entity_oxygen_resource",
                                    "comparison": "!=",
                                    "compare_to": 0
                                },
                                "if_action": {
                                    "type": "origins:change_resource",
                                    "resource": "anecdote:books/actors/target/force_drown/entity_oxygen_resource",
                                    "change": -1,
                                    "operation": "add"
                                },
                                "else_action": {
                                    "type": "origins:nothing"
                                }
                            }
                        },
                        {
                            "condition": {
                                "type": "origins:resource",
                                "resource": "anecdote:books/actors/target/force_drown/entity_condition_resource",
                                "comparison": "==",
                                "compare_to": 0
                            },
                            "action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "origins:set_resource",
                                        "resource": "anecdote:books/actors/target/force_drown/entity_oxygen_resource",
                                        "value": 300
                                    },
                                    {
                                        "type": "origins:revoke_power",
                                        "power": "anecdote:books/actors/target/force_drown/entity",
                                        "source": "force_drown"
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    },
    "condition_resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "oxygen_resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 300,
        "start_value": 300,
        "hud_render": {
            "should_render": false
        }
    },
    "particles": {
        "type": "origins:action_over_time",
        "interval": 6,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:choice",
                    "actions": [
                        {
                            "weight": 3,
                            "element": {
                                "type": "origins:execute_command",
                                "command": "particle bubble_pop ~ ~1 ~ 1 1 1 0 3"
                            }
                        },
                        {
                            "weight": 2,
                            "element": {
                                "type": "origins:execute_command",
                                "command": "particle bubble_pop ~ ~1 ~ 1 1 1 0 2"
                            }
                        },
                        {
                            "weight": 1,
                            "element": {
                                "type": "origins:execute_command",
                                "command": "particle bubble_pop ~ ~1 ~ 1 1 1 0 1"
                            }
                        }
                    ]
                },
                {
                    "type": "origins:chance",
                    "chance": 0.5,
                    "action": {
                        "type": "origins:choice",
                        "actions": [
                            {
                                "weight": 1,
                                "element": {
                                    "type": "origins:play_sound",
                                    "sound": "block.bubble_column.bubble_pop",
                                    "volume": 1,
                                    "pitch": 0.9
                                }
                            },
                            {
                                "weight": 1,
                                "element": {
                                    "type": "origins:play_sound",
                                    "sound": "block.bubble_column.bubble_pop",
                                    "volume": 1,
                                    "pitch": 1
                                }
                            },
                            {
                                "weight": 1,
                                "element": {
                                    "type": "origins:play_sound",
                                    "sound": "block.bubble_column.bubble_pop",
                                    "volume": 1,
                                    "pitch": 1.1
                                }
                            }
                        ]
                    }
                }
            ]
        }
    },
    "damage": {
        "condition": {
            "type": "origins:resource",
            "resource": "anecdote:books/actors/target/force_drown/entity_oxygen_resource",
            "comparison": "==",
            "compare_to": 0
        },
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:damage",
            "amount": 1,
            "source": {
                "name": "drown",
                "bypasses_armor": true,
                "unblockable": true
            }
        }
    }
}