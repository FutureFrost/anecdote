{
    "hidden": true,
    "type": "origins:multiple",
    "actor": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:if_else_list",
            "actions": [
                {
                    "condition": {
                        "type": "origins:in_block",
                        "block_condition": {
                            "type": "origins:movement_blocking"
                        }
                    },
                    "action": {
                        "type": "origins:execute_command",
                        "command": "kill @s"
                    }
                },
                {
                    "condition": {
                        "type": "origins:on_block",
                        "block_condition": {
                            "type": "origins:movement_blocking"
                        }
                    },
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:if_else_list",
                                "actions": [
                                    {
                                        "condition": {
                                            "type": "origins:and",
                                            "conditions": [
                                                {
                                                    "type": "origins:on_block",
                                                    "block_condition": {
                                                        "type": "origins:fluid",
                                                        "fluid_condition": {
                                                            "type": "origins:empty"
                                                        }
                                                    }
                                                },
                                                {
                                                    "type": "origins:in_block",
                                                    "block_condition": {
                                                        "type": "origins:block",
                                                        "block": "minecraft:air"
                                                    }
                                                }
                                            ]
                                        },
                                        "action": {
                                            "type": "origins:block_action_at",
                                            "block_action": {
                                                "type": "origins:set_block",
                                                "block": "minecraft:snow"
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "kill @s"
                            }
                        ]
                    }
                },
                {
                    "condition": {
                        "type": "origins:resource",
                        "resource": "anecdote:books/actors/summons/snowstorm_resource",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    "action": {
                        "type": "origins:execute_command",
                        "command": "kill @s"
                    }
                },
                {
                    "condition": {
                        "type": "origins:constant",
                        "value": true
                    },
                    "action": {
                        "type": "origins:change_resource",
                        "resource": "anecdote:books/actors/summons/snowstorm_resource",
                        "change": -1,
                        "operation": "add"
                    }
                }
            ]
        }
    },
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 200,
        "start_value": 200,
        "hud_render": {
            "should_render": false
        }
    }
}