{
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 5,
        "start_value": 5,
        "hud_render": {
            "should_render": false
        }
    },
    "clock": {
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:resource",
                "resource": "anecdote:books/actors/target/rotting_resource",
                "comparison": "==",
                "compare_to": 0
            },
            "if_action": {
                "type": "origins:revoke_power",
                "power": "anecdote:books/actors/target/rotting",
                "source": "rotting"
            },
            "else_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:damage",
                        "amount": 1,
                        "source": {
                            "name": "generic",
                            "bypasses_armor": true,
                            "unblockable": true
                        }
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "particle dust_color_transition 0.64 0.6 0.2 1 0.34 0.28 0 ~ ~1 ~ 0.5 0.5 0.5 0.1 3"
                    },
                    {
                        "type": "origins:change_resource",
                        "resource": "anecdote:books/actors/target/rotting_resource",
                        "change": -1,
                        "operation": "add"
                    }
                ]
            }
        }
    },
    "model_color": {
        "type": "origins:model_color",
        "red": 0.64,
        "green": 0.6,
        "blue": 0.2,
        "alpha": 1
    }
}